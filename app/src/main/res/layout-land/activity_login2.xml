<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout (not LinearLayout) so the low-internet icon can overlay the bottom-right corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/splashimage"
    tools:context=".Activites.LoginActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">


        <LinearLayout
            android:layout_width="@dimen/_200sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">







            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="@dimen/_3sdp"
                android:padding="@dimen/_5sdp"

                app:cardCornerRadius="@dimen/_10sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:orientation="vertical">


                   <ImageView
                       android:id="@+id/loginLogo"
                       android:layout_width="@dimen/_120sdp"
                       android:layout_height="@dimen/_68sdp"
                       android:scaleType="centerCrop"
                       android:layout_gravity="center"
                       android:src="@drawable/splogo_1"/>

                   <!-- Plays res/raw/splash_logo.mp4 (looping) when present; else the logo above shows. -->
                   <com.google.android.exoplayer2.ui.PlayerView
                       android:id="@+id/loginLogoVideo"
                       android:layout_width="@dimen/_160sdp"
                       android:layout_height="@dimen/_90sdp"
                       android:layout_gravity="center"
                       android:visibility="gone"
                       app:keep_content_on_player_reset="true"
                       app:resize_mode="fill"
                       app:shutter_background_color="@color/white"
                       app:surface_type="surface_view"
                       app:use_controller="false" />
                    <!--            <com.google.android.material.textfield.TextInputLayout-->
                    <!--                android:layout_width="match_parent"-->
                    <!--                android:layout_height="wrap_content"-->
                    <!--                app:boxBackgroundColor="@android:color/transparent"-->
                    <!--                android:background="@android:color/transparent"-->
                    <!--                android:layout_marginStart="@dimen/_10sdp"-->
                    <!--                android:layout_marginEnd="@dimen/_10sdp">-->

                    <!--                <com.google.android.material.textfield.TextInputEditText-->
                    <!--                    android:id="@+id/email_id"-->
                    <!--                    android:layout_width="match_parent"-->
                    <!--                    android:layout_height="wrap_content"-->
                    <!--                    android:layout_weight="1.4"-->
                    <!--                    android:hint="@string/email_add"-->
                    <!--                    android:inputType="textEmailAddress"-->
                    <!--                    android:paddingStart="@dimen/_2sdp"-->
                    <!--                    android:paddingEnd="@dimen/_5sdp"-->
                    <!--                    android:singleLine="true"-->
                    <!--                    android:textColor="@color/black"-->
                    <!--                    android:textSize="@dimen/_14sdp" />-->
                    <!--            </com.google.android.material.textfield.TextInputLayout>-->

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        app:passwordToggleTint="@color/colorPrimary"
                        app:shapeAppearance="@style/Rounded">

                        <com.cilpl.Cynergytx_admin.utils.EditTwCenMTFont
                            android:id="@+id/email_id"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_weight="1.4"
                            android:hint="@string/email_add"
                            android:inputType="text"
                            android:paddingStart="@dimen/_10sdp"
                            android:paddingEnd="@dimen/_5sdp"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_8sdp" />
                    </com.google.android.material.textfield.TextInputLayout>



                    <com.cilpl.Cynergytx_admin.utils.ButtonEditTwCenMTFont
                        android:id="@+id/signinbtn"
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_10sdp"
                        android:background="@drawable/btn0_bg"
                        android:gravity="center"
                        android:text="@string/submit_txt"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_8sdp" />

                    <!-- Inline activation error (replaces the old popup): icon + server message,
                         shown directly under the submit button. -->
                    <LinearLayout
                        android:id="@+id/activationErrorBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:background="@drawable/bg_error_inline"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5sdp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/activationErrorIcon"
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:src="@drawable/ic_error_inline" />

                        <TextView
                            android:id="@+id/activationErrorText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#C62828"
                            android:textSize="@dimen/_7sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Connectivity: status indicator, offline guidance and a route to Wi-Fi settings. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:gravity="center"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/offlineMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:gravity="center"
                            android:text="@string/offline_configure_wifi"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/_7sdp"
                            android:visibility="gone" />

                        <com.cilpl.Cynergytx_admin.utils.ButtonEditTwCenMTFont
                            android:id="@+id/configureWifiBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:background="@drawable/btn_wifi_blue"
                            android:focusable="true"
                            android:minWidth="0dp"
                            android:paddingStart="@dimen/_10sdp"
                            android:paddingEnd="@dimen/_10sdp"
                            android:text="@string/configure_wifi"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_7sdp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.cilpl.Cynergytx_admin.utils.TwCenMTBold
                        android:id="@+id/offlineplayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp"
                        android:layout_gravity="end"
                        android:visibility="gone"
                        android:text="@string/if_you_dont_have_key_click_here"/>




                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Transient green confirmation shown when the connection comes back. -->
    <TextView
        android:id="@+id/backOnlineStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#1E8E3E"
        android:gravity="center"
        android:padding="@dimen/_4sdp"
        android:text="@string/back_online"
        android:textColor="@color/white"
        android:textSize="@dimen/_8sdp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Low internet speed indicator: small, semi-transparent "no wifi" icon, bottom-right
         (blinks ~2x/minute while internet is <= 5 Mbps / offline). Same behaviour as the
         player screen, so the installer can see the connection state before activating. -->
    <ImageView
        android:id="@+id/lowSpeedDot"
        android:layout_width="@dimen/_14sdp"
        android:layout_height="@dimen/_14sdp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:alpha="0.6"
        android:scaleType="fitCenter"
        android:src="@drawable/no_wifi"
        android:visibility="gone" />

</FrameLayout>